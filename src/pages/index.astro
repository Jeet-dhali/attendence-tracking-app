            </ul>
          </div>
        </div>
        
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-border">
          <a href="/" class="flex items-center gap-2">
            <div class="w-6 h-6 rounded-md bg-accent flex items-center justify-center">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11l3 3 8-8"></path>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
              </svg>
            </div>
            <span class="text-sm font-medium">MyAttendTracker</span>
          </a>
          <p class="text-xs text-text-muted">© 2026 MyAttendTracker. Free attendance tracker for students.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Check if onboarding is complete, redirect accordingly
      const settings = JSON.parse(localStorage.getItem("att_settings") || "{}");
      
      function handleGetStarted() {
        if (settings.onboardingComplete) {
          window.location.replace("/dashboard");
        } else {
          window.location.replace("/setup");
        }
      }
      
      document.getElementById("get-started-btn")?.addEventListener("click", handleGetStarted);
      document.getElementById("hero-start-btn")?.addEventListener("click", handleGetStarted);
      document.getElementById("cta-start-btn")?.addEventListener("click", handleGetStarted);
    </script>

    <style>
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      .card {
        background: var(--color-bg-tertiary);
        border: 1px solid var(--color-border);
        border-radius: 12px;
      }
      .prose h2 {
        color: var(--color-text-primary);
        font-weight: 600;
      }
      .prose p {
        color: var(--color-text-secondary);
        line-height: 1.7;
      }
    </style>
  </body>
</html>
