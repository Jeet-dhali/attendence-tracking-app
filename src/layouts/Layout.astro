    </header>

    <!-- Bottom Navigation (Mobile) -->
    <nav
      id="bottom-nav"
      class="lg:hidden fixed bottom-0 left-0 right-0 h-16 bg-bg-secondary/90 backdrop-blur-xl border-t border-border z-40 flex items-center justify-around px-2"
    >
      <a
        href="/dashboard"
        data-nav="dashboard"
        class:list={[
          "bottom-nav-link flex flex-col items-center gap-1 px-3 py-1.5 rounded-xl transition-all duration-200",
          activeNav === "dashboard" ? "text-accent" : "text-text-muted",
        ]}
      >
        <svg
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="7" height="7" rx="1"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1"></rect>
