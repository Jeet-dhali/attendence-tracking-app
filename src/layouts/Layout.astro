---
interface Props {
  title?: string;
  activeNav?: string;
}

const { title = "MyAttendTracker", activeNav = "dashboard" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Track your college attendance effortlessly. Configure courses, build timetables, mark attendance, and get smart analytics — all in one beautiful app."
    />
    <meta
      name="keywords"
      content="attendance tracker, college attendance, student attendance, timetable, attendance calculator"
    />
    <meta name="author" content="MyAttendTracker" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="MyAttend" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="https://myattendtracker.com/sitemap.xml" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title} — MyAttendTracker</title>
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NEW43M9VQ1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-NEW43M9VQ1');
    </script>
  </head>
  <body class="min-h-screen bg-bg-primary text-text-primary font-sans">
    <!-- Sidebar (Desktop) -->
    <aside
      id="sidebar"
      class="fixed left-0 top-0 h-full w-[240px] bg-bg-secondary border-r border-border z-40 flex-col hidden lg:flex transition-all duration-300"
    >
      <!-- Logo -->
      <div class="px-5 py-5 flex items-center gap-3 border-b border-border">
        <a href="/" class="flex items-center gap-3">
          <div
            class="w-8 h-8 rounded-lg bg-accent flex items-center justify-center"
          >
            <svg
              class="w-5 h-5 text-white"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 11l3 3 8-8"></path>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-base font-semibold tracking-tight">MyAttendTracker</h1>
            <p class="text-[11px] text-text-muted font-mono">v1.0</p>
          </div>
        </a>
      </div>

      <!-- Nav Links -->
      <nav class="flex-1 px-3 py-4 space-y-1">
        <a
          href="/dashboard"
          id="nav-dashboard"
          data-nav="dashboard"
          class:list={[
            "nav-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200",
            activeNav === "dashboard"
              ? "bg-accent/10 text-accent"
              : "text-text-secondary hover:text-text-primary hover:bg-bg-tertiary",
          ]}
        >
          <svg
            class="w-[18px] h-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
          </svg>
          Dashboard
        </a>

        <!--<a
          href="/"
          id="nav-home"
          data-nav="home"
          class:list={[
            "nav-link group flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200",
            activeNav === "home"
              ? "bg-accent/10 text-accent"
              : "text-text-secondary hover:text-text-primary hover:bg-bg-tertiary",
          ]}
        >
          <svg
            class="w-[18px] h-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          </svg>
          Home
        </a>-->

        <a
