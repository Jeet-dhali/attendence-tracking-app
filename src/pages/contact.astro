---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- SEO Meta Tags -->
    <title>Contact Us — AttendEase Attendance Tracker</title>
    <meta name="description" content="Contact AttendEase team for support, feedback, or questions about our free attendance tracker app. We're here to help students with attendance tracking." />
    <meta name="keywords" content="contact us, support, feedback, attendance tracker support, help center, student support" />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Contact Us — AttendEase" />
    <meta property="og:description" content="Get in touch with the AttendEase team for support, feedback, or questions about our free attendance tracker." />
    
    <!-- Canonical -->
    <link rel="canonical" href="https://atteendease.com/contact" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-bg-primary text-text-primary font-sans">
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-bg-secondary/80 backdrop-blur-xl border-b border-border">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-md bg-accent flex items-center justify-center">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11l3 3 8-8"></path>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          </div>
          <span class="text-lg font-semibold tracking-tight">AttendEase</span>
        </a>
        <div class="flex items-center gap-4">
          <a href="/about" class="text-sm text-text-secondary hover:text-text-primary transition-colors">About</a>
          <a href="/privacy" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Privacy</a>
          <a href="/faq" class="text-sm text-text-secondary hover:text-text-primary transition-colors">FAQ</a>
        </div>
      </div>
    </nav>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-24">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Contact Us</h1>
      <p class="text-lg text-text-secondary mb-12">Have questions or feedback? We'd love to hear from you.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h2 class="text-xl font-semibold mb-6">Get in Touch</h2>
          <p class="text-text-secondary mb-8">Fill out the form below and we'll get back to you as soon as possible. We typically respond within 24-48 hours.</p>
          
          <form class="space-y-4">
            <div>
              <label class="block text-sm font-medium mb-2">Name</label>
              <input
                type="text"
                class="w-full h-10 px-4 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
                placeholder="Your name"
              />
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-2">Email</label>
              <input
                type="email"
                class="w-full h-10 px-4 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
                placeholder="your@email.com"
              />
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-2">Subject</label>
              <select
                class="w-full h-10 px-4 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
              >
                <option value="">Select a topic</option>
                <option value="general">General Inquiry</option>
                <option value="support">Technical Support</option>
                <option value="feedback">Feedback</option>
                <option value="feature">Feature Request</option>
                <option value="bug">Bug Report</option>
                <option value="other">Other</option>
              </select>
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-2">Message</label>
              <textarea
                rows="5"
                class="w-full px-4 py-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all resize-none"
                placeholder="How can we help you?"
              ></textarea>
            </div>
            
            <button
              type="submit"
              class="w-full h-11 px-5 bg-accent hover:bg-accent-hover text-white text-sm font-medium rounded-lg transition-all duration-200"
            >
              Send Message
            </button>
          </form>
        </div>
        
        <div>
          <h2 class="text-xl font-semibold mb-6">Quick Links</h2>
          <div class="space-y-4">
            <a href="/about" class="block p-4 rounded-lg bg-bg-tertiary border border-border hover:border-accent/30 transition-all">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-accent-soft flex items-center justify-center">
                  <svg class="w-5 h-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium">About Us</div>
                  <div class="text-xs text-text-muted">Learn more about AttendEase</div>
                </div>
              </div>
            </a>
            
            <a href="/privacy" class="block p-4 rounded-lg bg-bg-tertiary border border-border hover:border-accent/30 transition-all">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-success-soft flex items-center justify-center">
                  <svg class="w-5 h-5 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7z"></path>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium">Privacy Policy</div>
                  <div class="text-xs text-text-muted">How we protect your data</div>
                </div>
              </div>
            </a>
            
            <a href="/terms" class="block p-4 rounded-lg bg-bg-tertiary border border-border hover:border-accent/30 transition-all">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-warning-soft flex items-center justify-center">
                  <svg class="w-5 h-5 text-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"></path>
                    <path d="M16 11h-3"></path>
                    <path d="M8 11H5"></path>
                    <path d="M16 15h-3"></path>
                    <path d="M8 15H5"></path>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium">Terms & Conditions</div>
                  <div class="text-xs text-text-muted">Our terms of service</div>
                </div>
              </div>
            </a>
            
            <a href="/" class="block p-4 rounded-lg bg-bg-tertiary border border-border hover:border-accent/30 transition-all">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-info-soft flex items-center justify-center">
                  <svg class="w-5 h-5 text-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium">FAQ</div>
                  <div class="text-xs text-text-muted">Frequently asked questions</div>
                </div>
              </div>
            </a>
          </div>
          
          <div class="mt-8 p-6 rounded-lg bg-bg-tertiary border border-border">
            <h3 class="text-sm font-semibold mb-4">Response Time</h3>
            <p class="text-sm text-text-secondary">We typically respond to all inquiries within 24-48 hours during business days. For urgent matters, please mention "URGENT" in your subject line.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="py-8 px-4 sm:px-6 border-t border-border">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-md bg-accent flex items-center justify-center">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11l3 3 8-8"></path>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          </div>
          <span class="text-sm font-medium">AttendEase</span>
        </a>
        <p class="text-xs text-text-muted">© 2026 AttendEase. Free attendance tracker for students.</p>
      </div>
    </footer>

    <style>
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
    </style>
  </body>
</html>
