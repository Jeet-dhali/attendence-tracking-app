          Start Using MyAttendTracker Free
        </button>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 px-4 sm:px-6 border-t border-border">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
          <div>
