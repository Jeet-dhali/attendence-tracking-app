---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="Setup" activeNav="setup">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-6 sm:py-10 animate-fade-in">
    <!-- Progress Bar -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-3">
        <h2
          class="text-lg sm:text-xl font-semibold tracking-tight"
          id="step-title"
        >
          Step 1 — Your Details
        </h2>
        <span class="text-xs font-mono text-text-muted" id="step-count"
          >1 / 4</span
        >
      </div>
      <div class="progress-bar">
        <div
          class="progress-fill bg-accent"
          id="progress-fill"
          style="width: 25%"
        >
        </div>
      </div>
    </div>

    <!-- ═══ STEP 0: User Details ═══ -->
    <div id="step-0" class="step-panel">
      <div class="card p-4 sm:p-6 mb-6">
        <h3 class="text-sm font-semibold text-text-secondary mb-1">
          Personal Information
        </h3>
        <p class="text-xs text-text-muted mb-4">
          Tell us a bit about yourself. This information is optional and will be stored locally on your device.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text-muted mb-1.5"
              >Full Name (Optional)</label
            >
            <input
              type="text"
              id="user-name"
              placeholder="e.g. John Doe"
              class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-text-muted mb-1.5"
              >Roll Number (Optional)</label
            >
            <input
              type="text"
              id="user-roll"
              placeholder="e.g. 2023001"
              class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-text-muted mb-1.5"
              >Branch (Optional)</label
            >
            <input
              type="text"
              id="user-branch"
              placeholder="e.g. Computer Science"
              class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-text-muted mb-1.5"
              >Year (Optional)</label
            >
            <select
              id="user-year"
              class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            >
              <option value="">Select Year</option>
              <option value="1">1st Year</option>
              <option value="2">2nd Year</option>
              <option value="3">3rd Year</option>
              <option value="4">4th Year</option>
              <option value="5">5th Year</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text-muted mb-1.5"
              >Semester (Optional)</label
            >
            <select
              id="user-semester"
              class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            >
              <option value="">Select Semester</option>
              <option value="1">Semester 1</option>
              <option value="2">Semester 2</option>
              <option value="3">Semester 3</option>
              <option value="4">Semester 4</option>
              <option value="5">Semester 5</option>
              <option value="6">Semester 6</option>
              <option value="7">Semester 7</option>
              <option value="8">Semester 8</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-text-muted mb-1.5"
              >Section (Optional)</label
            >
            <input
              type="text"
              id="user-section"
              placeholder="e.g. A, B, C"
              class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            />
          </div>
        </div>
      </div>

      <div class="card p-4 sm:p-6">
        <h3 class="text-sm font-semibold text-text-secondary mb-1">
          Privacy Note
        </h3>
        <p class="text-xs text-text-muted">
          All your information is stored locally in your browser. No data is sent to any server. You can update or remove this information anytime from the settings.
        </p>
      </div>
    </div>

    <!-- ═══ STEP 1: Courses ═══ -->
    <div id="step-1" class="step-panel hidden">
      <div class="card p-4 sm:p-6 mb-6">
        <h3 class="text-sm font-semibold text-text-secondary mb-1">
          Add a Course
        </h3>
        <p class="text-xs text-text-muted mb-4">
          Enter your course code and name. You can add as many courses as you
          need.
        </p>

        <div
          class="grid grid-cols-1 sm:grid-cols-[1fr_2fr_auto] gap-3 items-end"
        >
          <div>
            <label class="block text-xs font-medium text-text-muted mb-1.5"
              >Course Code</label
            >
            <input
              type="text"
              id="course-code"
              placeholder="e.g. CS301"
              class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-text-muted mb-1.5"
              >Course Name</label
            >
            <input
              type="text"
              id="course-name"
              placeholder="e.g. Data Structures"
              class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            />
          </div>
          <button
            id="add-course-btn"
            class="h-10 px-5 bg-accent hover:bg-accent-hover text-white text-sm font-medium rounded-lg transition-all duration-200 active:scale-95 cursor-pointer whitespace-nowrap"
          >
            + Add
          </button>
        </div>

        <!-- Advanced Options (collapsible) -->
        <details class="mt-3">
          <summary
            class="text-xs text-text-muted cursor-pointer hover:text-text-secondary transition-colors"
            >Advanced options</summary
          >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1.5"
                >Min Attendance %</label
              >
              <input
                type="number"
                id="course-min"
                value="75"
                min="0"
                max="100"
                class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
              />
            </div>
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1.5"
                >Color</label
              >
              <input
                type="color"
                id="course-color"
                value="#0070f3"
                class="w-full h-10 bg-bg-tertiary border border-border rounded-lg cursor-pointer"
              />
            </div>
          </div>
        </details>
      </div>

      <!-- Course List -->
      <div id="course-list" class="space-y-2 mb-6"></div>

      <!-- Empty State -->
      <div id="empty-courses" class="card p-8 sm:p-12 text-center">
        <div
          class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center mx-auto mb-4"
        >
          <svg
            class="w-7 h-7 text-accent"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"
            ></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold mb-1">No courses added yet</h3>
        <p class="text-sm text-text-muted">
          Add your first course above to get started.
        </p>
      </div>
    </div>

    <!-- ═══ STEP 2: Timetable ═══ -->
    <div id="step-2" class="step-panel hidden">
      <div class="card p-4 sm:p-6 mb-4">
        <h3 class="text-sm font-semibold text-text-secondary mb-1">
          Build Your Timetable
        </h3>
        <p class="text-xs text-text-muted mb-4">
          Click on a cell to assign a course. Click again to remove it.
        </p>

        <!-- Period Times Config -->
        <details class="mb-4">
          <summary
            class="text-xs text-text-muted cursor-pointer hover:text-text-secondary transition-colors"
            >Configure period times</summary
          >
          <div
            class="grid grid-cols-1 gap-2 mt-3 overflow-hidden sm:grid-flow-col sm:grid-cols-2 sm:grid-rows-4 sm:max-w-2xl"
            id="period-times-config"
          >
          </div>
        </details>
      </div>

      <!-- Timetable Grid -->
      <div class="overflow-x-auto -mx-4 sm:mx-0">
        <div class="min-w-[640px] px-4 sm:px-0">
          <table class="w-full border-collapse" id="timetable-grid">
            <thead>
              <tr>
                <th
                  class="text-[11px] font-mono text-text-muted uppercase tracking-wider p-2 text-left w-20"
                  >Day</th
                >
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>

      <!-- Course Palette for Selection -->
      <div
        id="course-palette"
        class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
      >
        <div class="card p-4 w-[90%] max-w-sm animate-scale-in">
          <h4 class="text-sm font-semibold mb-3">Select Course</h4>
          <div
            id="palette-courses"
            class="space-y-1.5 max-h-60 overflow-y-auto"
          >
          </div>
          <div class="mt-3 pt-3 border-t border-border flex gap-2">
            <button
              id="palette-remove"
              class="flex-1 h-9 text-xs font-medium text-danger bg-danger-soft rounded-lg hover:bg-danger/20 transition-all cursor-pointer"
              >Remove</button
            >
            <button
              id="palette-cancel"
              class="flex-1 h-9 text-xs font-medium text-text-secondary bg-bg-tertiary rounded-lg hover:bg-bg-elevated transition-all cursor-pointer"
              >Cancel</button
            >
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ STEP 3: Semester ═══ -->
    <div id="step-3" class="step-panel hidden">
      <div class="card p-4 sm:p-6 mb-6">
        <h3 class="text-sm font-semibold text-text-secondary mb-1">
          Semester Details
        </h3>
        <p class="text-xs text-text-muted mb-4">
          Set your semester start and end dates for accurate predictions.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-text-muted mb-1.5"
              >Semester Start</label
            >
            <input
              type="date"
              id="sem-start"
              class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-text-muted mb-1.5"
              >Semester End</label
            >
            <input
              type="date"
              id="sem-end"
              class="w-full h-10 px-3 bg-bg-tertiary border border-border rounded-lg text-sm text-text-primary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent/30 transition-all"
            />
          </div>
        </div>
      </div>

      <!-- Summary -->
      <div class="card p-4 sm:p-6">
        <h3 class="text-sm font-semibold text-text-secondary mb-3">
          Setup Summary
        </h3>
        <div id="setup-summary" class="space-y-3"></div>
      </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="flex items-center justify-between mt-8">
      <button
        id="prev-btn"
        class="hidden h-10 px-5 text-sm font-medium text-text-secondary bg-bg-tertiary hover:bg-bg-elevated rounded-lg transition-all duration-200 cursor-pointer"
      >
        ← Back
      </button>
      <div class="flex-1"></div>
      <button
        id="next-btn"
        class="h-10 px-6 text-sm font-medium text-white bg-accent hover:bg-accent-hover rounded-lg transition-all duration-200 active:scale-95 cursor-pointer"
      >
        Next →
      </button>
    </div>
  </div>

  <script>
    import {
      getCourses,
      addCourse,
      deleteCourse,
      getTimetable,
      setTimetableSlot,
      removeTimetableSlot,
      getSettings,
      updateSettings,
      DAYS,
      COURSE_COLORS,
    } from "../scripts/store.js";

    const PERIODS = 8;
    const DEFAULT_TIMES = [
      { start: "09:00", end: "09:50" },
      { start: "10:00", end: "10:50" },
      { start: "11:00", end: "11:50" },
      { start: "12:00", end: "12:50" },
      { start: "13:30", end: "14:20" },
      { start: "14:30", end: "15:20" },
      { start: "15:30", end: "16:20" },
      { start: "16:30", end: "17:20" },
    ];

    declare global {
      interface Window {
        showToast: (message: string, type?: string) => void;
      }
    }

    let currentStep = 1;
    let selectedCell: any = null;

    // ─── Step Navigation ────────────────────────
    const steps = document.querySelectorAll(".step-panel");
    const titles = [
      "Step 1 — Your Details",
      "Step 2 — Add Your Courses",
      "Step 3 — Build Timetable",
      "Step 4 — Semester Details",
    ];
    const stepTitle = document.getElementById("step-title");
    const stepCount = document.getElementById("step-count");
    const progressFill = document.getElementById("progress-fill");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");

    function showStep(step: number) {
      currentStep = step;
      steps.forEach((panel: any, i: any) => {
        panel.classList.toggle("hidden", i !== step - 1);
      });
      stepTitle!.textContent = titles[step - 1];
      stepCount!.textContent = `${step} / 4`;
      progressFill!.style.width = `${(step / 4) * 100}%`;
      prevBtn!.classList.toggle("hidden", step === 1);
      nextBtn!.textContent = step === 4 ? "✓ Finish Setup" : "Next →";

      if (step === 3) renderTimetable();
      if (step === 4) renderSummary();
    }

    prevBtn!.addEventListener("click", () => showStep(currentStep - 1));
    nextBtn!.addEventListener("click", () => {
      if (currentStep === 2 && getCourses().length === 0) {
        window.showToast("Please add at least one course", "warning");
        return;
      }
      if (currentStep === 1) {
        // Save user details
        const userName = (document.getElementById("user-name") as HTMLInputElement).value.trim();
        const userRoll = (document.getElementById("user-roll") as HTMLInputElement).value.trim();
        const userBranch = (document.getElementById("user-branch") as HTMLInputElement).value.trim();
        const userYear = (document.getElementById("user-year") as HTMLSelectElement).value;
        const userSemester = (document.getElementById("user-semester") as HTMLSelectElement).value;
        const userSection = (document.getElementById("user-section") as HTMLInputElement).value.trim();
        
        updateSettings({
          userName,
          userRoll,
          userBranch,
          userYear,
          userSemester,
          userSection,
        });
      }
      if (currentStep === 4) {
        // Save semester dates
        const semStart = (
          document.getElementById("sem-start") as HTMLInputElement
        ).value;
        const semEnd = (document.getElementById("sem-end") as HTMLInputElement)
          .value;
        updateSettings({
          semesterStart: semStart,
          semesterEnd: semEnd,
          onboardingComplete: true,
        });
        window.showToast("Setup complete! 🎉", "success");
        setTimeout(() => (window.location.href = "/dashboard"), 800);
        return;
      }
      showStep(currentStep + 1);
    });

    // ─── Step 1: Courses ────────────────────────
    const codeInput = document.getElementById(
      "course-code",
    ) as HTMLInputElement;
    const nameInput = document.getElementById(
      "course-name",
    ) as HTMLInputElement;
    const minInput = document.getElementById("course-min") as HTMLInputElement;
    const colorInput = document.getElementById(
      "course-color",
    ) as HTMLInputElement;
    const addBtn = document.getElementById("add-course-btn");
    const courseList = document.getElementById("course-list");
    const emptyCourses = document.getElementById("empty-courses");

    function renderCourses() {
      const courses = getCourses();
      courseList!.innerHTML = "";
      emptyCourses!.classList.toggle("hidden", courses.length > 0);

      courses.forEach((course: any, i: any) => {
        const div = document.createElement("div");
        div.className =
          "card p-3 sm:p-4 flex items-center gap-3 animate-slide-up";
        div.style.animationDelay = `${i * 0.05}s`;
        div.style.animationFillMode = "both";
        div.innerHTML = `
          <div class="w-3 h-3 rounded-full flex-shrink-0" style="background: ${course.color}"></div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono text-text-muted">${course.code}</span>
              <span class="text-sm font-medium truncate">${course.name}</span>
            </div>
            <span class="text-[11px] text-text-muted">Min: ${course.minAttendance}%</span>
          </div>
          <button class="delete-course p-1.5 rounded-md text-text-muted hover:text-danger hover:bg-danger-soft transition-all cursor-pointer" data-id="${course.id}">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
            </svg>
          </button>
        `;
        courseList!.appendChild(div);
      });

      // Update color for next course
      colorInput.value = COURSE_COLORS[courses.length % COURSE_COLORS.length];

      // Delete handlers
      document.querySelectorAll(".delete-course").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const id = (e.currentTarget as HTMLElement).dataset.id;
          deleteCourse(id);
          renderCourses();
          window.showToast("Course removed", "info");
        });
      });
    }

    addBtn!.addEventListener("click", () => {
      const code = codeInput.value.trim();
      const name = nameInput.value.trim();
      if (!code || !name) {
        window.showToast("Please enter both code and name", "warning");
        return;
      }
      addCourse({
        code,
        name,
        color: colorInput.value,
        minAttendance: parseInt(minInput.value) || 75,
      });
      codeInput.value = "";
      nameInput.value = "";
      codeInput.focus();
      renderCourses();
      window.showToast(`Added ${code}`, "success");
    });

    // Handle Enter key
    [codeInput, nameInput].forEach((input: any) => {
      input!.addEventListener("keydown", (e: any) => {
        if (e.key === "Enter") addBtn!.click();
      });
    });

    // ─── Step 2: Timetable ──────────────────────
    function renderTimetable() {
      const courses = getCourses();
      const timetable = getTimetable();
      const grid = document.getElementById("timetable-grid");
      const thead = grid!.querySelector("thead tr");
      const tbody = grid!.querySelector("tbody");

      // Build header
      thead!.innerHTML =
        '<th class="text-[11px] font-mono text-text-muted uppercase tracking-wider p-2 text-left w-20 border-b border-border">Day</th>';
      for (let p = 1; p <= PERIODS; p++) {
        const time = DEFAULT_TIMES[p - 1];
        thead!.innerHTML += `<th class="text-[11px] font-mono text-text-muted text-center p-2 border-b border-border min-w-[72px]">P${p}<br><span class="text-text-muted/60">${time.start}</span></th>`;
      }

      // Build body
      tbody!.innerHTML = "";
      DAYS.forEach((day: any) => {
        const row = document.createElement("tr");
        row.innerHTML = `<td class="text-xs font-medium text-text-secondary p-2 border-b border-border capitalize">${day.slice(0, 3)}</td>`;

        for (let p = 1; p <= PERIODS; p++) {
          const slot = (timetable[day] || []).find((s: any) => s.period === p);
          const course = slot
            ? courses.find((c: any) => c.id === slot.courseId)
            : null;
          const td = document.createElement("td");
          td.className = "p-1 border-b border-border";

          const cellBtn = document.createElement("button");
          cellBtn.className =
            "w-full h-10 rounded-md text-[10px] font-medium transition-all duration-200 cursor-pointer border";

          if (course) {
            cellBtn.style.background = `${course.color}18`;
            cellBtn.style.borderColor = `${course.color}40`;
            cellBtn.style.color = course.color;
            cellBtn.textContent = course.code;
          } else {
            cellBtn.className +=
              " bg-bg-tertiary/50 border-transparent text-text-muted/40 hover:bg-bg-tertiary hover:text-text-muted";
            cellBtn.textContent = "+";
          }

          cellBtn.addEventListener("click", () => openPalette(day, p));
          td.appendChild(cellBtn);
          row.appendChild(td);
        }
        tbody!.appendChild(row);
      });

      // Period times config
      const timesConfig = document.getElementById("period-times-config");
      timesConfig!.innerHTML = "";
      for (let p = 0; p < PERIODS; p++) {
        const time = DEFAULT_TIMES[p];
        timesConfig!.innerHTML += `
          <div class="flex items-center gap-1 text-[11px] text-text-muted min-w-0">
            <span class="font-mono w-6 flex-shrink-0">P${p + 1}</span>
            <input type="time" value="${time.start}" class="flex-1 min-w-0 h-7 px-1 bg-bg-tertiary border border-border rounded text-[11px] text-text-primary" data-period="${p}" data-type="start"/>
            <span class="flex-shrink-0">-</span>
            <input type="time" value="${time.end}" class="flex-1 min-w-0 h-7 px-1 bg-bg-tertiary border border-border rounded text-[11px] text-text-primary" data-period="${p}" data-type="end"/>
          </div>
        `;
      }
    }

    function openPalette(day: any, period: any) {
      selectedCell = { day, period };
      const courses = getCourses();
      const palette = document.getElementById("course-palette");
      const paletteCourses = document.getElementById("palette-courses");

      paletteCourses!.innerHTML = "";
      courses.forEach((course: any) => {
        const btn = document.createElement("button");
        btn.className =
          "w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-left hover:bg-bg-tertiary transition-all cursor-pointer";
        btn.innerHTML = `
          <div class="w-3 h-3 rounded-full flex-shrink-0" style="background: ${course.color}"></div>
          <span class="text-xs font-mono text-text-muted w-14">${course.code}</span>
          <span class="text-sm flex-1 truncate">${course.name}</span>
        `;
        btn.addEventListener("click", () => {
          const time = DEFAULT_TIMES[period - 1];
          setTimetableSlot(day, period, course.id, time.start, time.end);
          closePalette();
          renderTimetable();
        });
        paletteCourses!.appendChild(btn);
      });

      palette!.classList.remove("hidden");
    }

    function closePalette() {
      document.getElementById("course-palette")!.classList.add("hidden");
      selectedCell = null;
    }

    // ─── Step 3: Summary ────────────────────────
    function renderSummary() {
      const courses = getCourses();
      const timetable = getTimetable();
      const summary = document.getElementById("setup-summary");
      const settings = getSettings();

      // Pre-fill semester dates
      if (settings.semesterStart)
        (document.getElementById("sem-start") as HTMLInputElement).value =
          settings.semesterStart;
      if (settings.semesterEnd)
        (document.getElementById("sem-end") as HTMLInputElement).value =
          settings.semesterEnd;

      let ttCount = 0;
      DAYS.forEach((day) => {
        ttCount += (timetable[day] || []).length;
      });

      summary!.innerHTML = `
        <div class="flex items-center gap-3 p-3 rounded-lg bg-bg-tertiary">
          <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center">
            <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div>
            <div class="text-sm font-medium">${settings.userName || "Your Name"}</div>
            <div class="text-[11px] text-text-muted">${settings.userRoll ? settings.userRoll : "No roll number"} ${settings.userBranch ? "• " + settings.userBranch : ""}</div>
          </div>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-lg bg-bg-tertiary">
          <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center">
            <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path></svg>
          </div>
          <div>
            <div class="text-sm font-medium">${courses.length} Course${courses.length !== 1 ? "s" : ""}</div>
            <div class="text-[11px] text-text-muted">${courses.map((c: any) => c.code).join(", ") || "None"}</div>
          </div>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-lg bg-bg-tertiary">
          <div class="w-8 h-8 rounded-lg bg-purple/10 flex items-center justify-center">
            <svg class="w-4 h-4 text-purple" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </div>
          <div>
            <div class="text-sm font-medium">${ttCount} Period${ttCount !== 1 ? "s" : ""} / week</div>
            <div class="text-[11px] text-text-muted">Across ${DAYS.filter((d) => (timetable[d] || []).length > 0).length} days</div>
          </div>
        </div>
      `;
    }

    // ─── Init ───────────────────────────────────
    renderCourses();

    // Pre-fill user details if already saved
    const settings = getSettings();
    if (settings.userName)
      (document.getElementById("user-name") as HTMLInputElement).value = settings.userName;
    if (settings.userRoll)
      (document.getElementById("user-roll") as HTMLInputElement).value = settings.userRoll;
    if (settings.userBranch)
      (document.getElementById("user-branch") as HTMLInputElement).value = settings.userBranch;
    if (settings.userYear)
      (document.getElementById("user-year") as HTMLSelectElement).value = settings.userYear;
    if (settings.userSemester)
      (document.getElementById("user-semester") as HTMLSelectElement).value = settings.userSemester;
    if (settings.userSection)
      (document.getElementById("user-section") as HTMLInputElement).value = settings.userSection;

    // Setup palette event listeners
    document
      .getElementById("palette-cancel")!
      .addEventListener("click", closePalette);
    document.getElementById("palette-remove")!.addEventListener("click", () => {
      if (selectedCell) {
        removeTimetableSlot(selectedCell.day, selectedCell.period);
        closePalette();
        renderTimetable();
      }
    });

    document
      .getElementById("course-palette")!
      .addEventListener("click", (e) => {
        if (e.target === e.currentTarget) closePalette();
      });

    // If onboarding is already complete, start at step 1 (edit mode)
    if (settings.onboardingComplete) {
      nextBtn!.textContent = "Next →";
    }
  </script>
</Layout>
