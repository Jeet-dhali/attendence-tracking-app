---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="Analytics" activeNav="analytics">
  <script is:inline>
    // Check if onboarding is complete
    const settings = JSON.parse(localStorage.getItem("att_settings") || "{}");
    if (!settings.onboardingComplete) {
      window.location.replace("/setup");
    }
  </script>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 animate-fade-in">
    <!-- Header -->
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight">
        Advanced Analytics
      </h2>
      <p class="text-sm text-text-muted mt-0.5">
        Deep insights into your attendance patterns
      </p>
    </div>

    <!-- Time Period Tabs -->
    <div class="flex items-center gap-2 mb-6 overflow-x-auto pb-2">
      <button
        data-period="week"
        class="time-period-btn px-4 py-2 text-sm font-medium rounded-lg bg-accent text-white transition-all"
      >
        This Week
      </button>
      <button
        data-period="month"
        class="time-period-btn px-4 py-2 text-sm font-medium rounded-lg bg-bg-tertiary text-text-secondary hover:bg-bg-elevated transition-all"
      >
        This Month
      </button>
      <button
        data-period="semester"
        class="time-period-btn px-4 py-2 text-sm font-medium rounded-lg bg-bg-tertiary text-text-secondary hover:bg-bg-elevated transition-all"
      >
        Semester
      </button>
      <button
        data-period="all"
        class="time-period-btn px-4 py-2 text-sm font-medium rounded-lg bg-bg-tertiary text-text-secondary hover:bg-bg-elevated transition-all"
      >
        All Time
      </button>
    </div>

    <!-- Heat Map Section -->
    <div class="card p-4 sm:p-6 mb-6 animate-slide-up stagger-1">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold">Attendance Heat Map</h3>
        <div class="flex items-center gap-3 text-[11px] text-text-muted">
          <div class="flex items-center gap-1">
            <div class="w-3 h-3 rounded bg-success"></div>
            <span>100%</span>
          </div>
          <div class="flex items-center gap-1">
            <div class="w-3 h-3 rounded bg-success/80"></div>
            <span>75-99%</span>
          </div>
          <div class="flex items-center gap-1">
            <div class="w-3 h-3 rounded bg-warning"></div>
            <span>50-74%</span>
          </div>
          <div class="flex items-center gap-1">
            <div class="w-3 h-3 rounded bg-danger"></div>
            <span>0-49%</span>
          </div>
          <div class="flex items-center gap-1">
            <div class="w-3 h-3 rounded bg-bg-tertiary"></div>
            <span>No data</span>
          </div>
        </div>
      </div>
      <div id="heatmap-container" class="overflow-x-auto">
        <!-- Populated by JS -->
      </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <!-- Comparative Course Chart -->
      <div class="card p-4 sm:p-6 animate-slide-up stagger-2">
        <h3 class="text-sm font-semibold mb-4">Course Comparison</h3>
        <div id="course-comparison" class="h-64">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Attendance Distribution -->
      <div class="card p-4 sm:p-6 animate-slide-up stagger-3">
        <h3 class="text-sm font-semibold mb-4">Status Distribution</h3>
        <div id="status-distribution" class="h-64">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>

    <!-- Course Deep Dive -->
    <div class="card p-4 sm:p-6 mb-6 animate-slide-up stagger-4">
      <h3 class="text-sm font-semibold mb-4">Course Deep Dive</h3>
      <div id="course-deep-dive" class="space-y-4">
        <!-- Populated by JS -->
      </div>
    </div>

    <!-- Predictions Section -->
    <div class="card p-4 sm:p-6 mb-6 animate-slide-up stagger-5">
      <h3 class="text-sm font-semibold mb-4">Attendance Predictions</h3>
      <div id="predictions" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Populated by JS -->
      </div>
    </div>

    <!-- Weekly Pattern Analysis -->
    <div class="card p-4 sm:p-6 animate-slide-up stagger-6">
      <h3 class="text-sm font-semibold mb-4">Weekly Pattern Analysis</h3>
      <div id="weekly-pattern" class="h-48">
        <!-- Populated by JS -->
      </div>
    </div>
    
    <!-- Link to Bunk Calculator -->
    <!--<div class="card p-4 sm:p-6 animate-slide-up stagger-7">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-semibold mb-1">Advanced Bunk Calculator</h3>
          <p class="text-xs text-text-muted">Plan your bunks strategically with what-if scenarios</p>
        </div>
        <a
          href="/bunk"
          class="h-10 px-5 bg-accent hover:bg-accent-hover text-white text-sm font-medium rounded-lg transition-all duration-200 active:scale-95"
        >
          Open Calculator →
        </a>
      </div>
    </div>-->
  </div>

  <script>
    import {
      getCourses,
      getCourseById,
      getOverallStats,
      getCourseStats,
      getAttendanceTrend,
      getRecords,
      formatDate,
      getToday,
      getPredictedPercentage,
    } from "../scripts/store.js";

    declare global {
      interface Window {
        showToast: (message: string, type?: string) => void;
      }
    }

    // State
    let currentTimePeriod = "week";

    // Initialize
    function init() {
      renderHeatMap();
      renderCourseComparison();
      renderStatusDistribution();
      renderCourseDeepDive();
      renderPredictions();
      renderWeeklyPattern();
      setupEventListeners();
    }

    // Helper functions
    function getStatusColor(pct) {
      if (pct >= 75) return "bg-success";
      if (pct >= 50) return "bg-success/80";
      if (pct >= 25) return "bg-warning";
      return "bg-danger";
    }

    // Heat Map
    function renderHeatMap() {
      const records = getRecords();
      const courses = getCourses();
      const dates = Object.keys(records).sort().slice(-90); // Last 90 days
      
      if (dates.length === 0) {
        document.getElementById("heatmap-container")!.innerHTML = `
          <div class="h-32 flex items-center justify-center">
            <p class="text-sm text-text-muted">No attendance data yet</p>
          </div>
        `;
        return;
      }

      let html = `<div class="grid gap-1" style="grid-template-columns: 120px repeat(${Math.min(dates.length, 30)}, 1fr)">`;
      
      // Header row with dates
      html += `<div></div>`;
      dates.slice(-30).forEach(date => {
        const d = new Date(date);
        html += `<div class="text-[9px] text-text-muted text-center rotate-45 origin-left">${d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</div>`;
      });
      
      // Course rows
      courses.forEach(course => {
        html += `<div class="text-xs font-medium text-text-secondary truncate">${course.code}</div>`;
        
        dates.slice(-30).forEach(date => {
          const dayRecords = records[date] || {};
          let attended = 0;
          let total = 0;
          
          Object.values(dayRecords).forEach((entry: any) => {
            if (entry.courseId === course.id) {
              if (["present", "late", "on_duty"].includes(entry.status)) {
                attended++;
                total++;
              } else if (entry.status === "absent") {
                total++;
              }
            }
          });
          
          const pct = total > 0 ? Math.round((attended / total) * 100) : 0;
          const bgColor = getStatusColor(pct);
          
          html += `<div class="aspect-square rounded ${bgColor} cursor-pointer" title="${course.code}: ${pct}% (${attended}/${total})"></div>`;
        });
      });
      
      html += `</div>`;
      document.getElementById("heatmap-container")!.innerHTML = html;
    }

    // Course Comparison Chart
    function renderCourseComparison() {
      const stats = getOverallStats();
      
      if (stats.courseStats.length === 0) {
        document.getElementById("course-comparison")!.innerHTML = `
          <div class="h-full flex items-center justify-center">
            <p class="text-sm text-text-muted">No courses configured</p>
          </div>
        `;
        return;
      }

      const maxValue = 100;
      const barHeight = 20;
      const gap = 8;
      const chartHeight = stats.courseStats.length * (barHeight + gap);
      
      let html = `<div class="space-y-2">`;
      
      stats.courseStats.forEach((course, i) => {
        const width = Math.max(course.percentage, 5);
        const color = course.percentage >= 75 ? "bg-success" : course.percentage >= 60 ? "bg-warning" : "bg-danger";
        
        html += `
          <div class="flex items-center gap-3">
            <div class="w-16 text-xs font-medium text-text-secondary truncate">${course.code}</div>
            <div class="flex-1 h-4 bg-bg-tertiary rounded-full overflow-hidden">
              <div class="h-full ${color} rounded-full transition-all duration-500" style="width: ${width}%"></div>
            </div>
            <div class="w-12 text-xs font-semibold text-right">${course.percentage}%</div>
          </div>
        `;
      });
      
      html += `</div>`;
      document.getElementById("course-comparison")!.innerHTML = html;
    }

    // Status Distribution
    function renderStatusDistribution() {
      const records = getRecords();
      const stats = { present: 0, absent: 0, late: 0, on_duty: 0, holiday: 0, cancelled: 0 };
      
      Object.values(records).forEach(dayRecords => {
        Object.values(dayRecords).forEach((entry: any) => {
          if (stats[entry.status] !== undefined) {
            stats[entry.status]++;
          }
        });
      });
      
      const total = Object.values(stats).reduce((a, b) => a + b, 0);
      
      if (total === 0) {
        document.getElementById("status-distribution")!.innerHTML = `
          <div class="h-full flex items-center justify-center">
            <p class="text-sm text-text-muted">No data yet</p>
          </div>
        `;
        return;
      }

      const colors = {
        present: "bg-success",
        absent: "bg-danger",
        late: "bg-warning",
        on_duty: "bg-cyan",
        holiday: "bg-info",
        cancelled: "bg-text-muted"
      };
      
      const labels = {
        present: "Present",
        absent: "Absent",
        late: "Late",
        on_duty: "On Duty",
        holiday: "Holiday",
        cancelled: "Cancelled"
      };
      
      let html = `<div class="grid grid-cols-2 gap-4">`;
      
      Object.entries(stats).forEach(([status, count]) => {
        if (count === 0) return;
        const pct = Math.round((count / total) * 100);
        
        html += `
          <div class="text-center">
            <div class="text-2xl font-bold text-text-primary">${count}</div>
            <div class="text-xs text-text-muted mb-1">${labels[status as keyof typeof labels]}</div>
            <div class="h-2 bg-bg-tertiary rounded-full overflow-hidden">
              <div class="h-full ${colors[status as keyof typeof colors]} rounded-full" style="width: ${pct}%"></div>
            </div>
            <div class="text-[10px] text-text-muted mt-1">${pct}%</div>
          </div>
        `;
      });
      
      html += `</div>`;
      document.getElementById("status-distribution")!.innerHTML = html;
    }

    // Course Deep Dive
    function renderCourseDeepDive() {
      const stats = getOverallStats();
      
      if (stats.courseStats.length === 0) {
        document.getElementById("course-deep-dive")!.innerHTML = `
          <div class="py-8 text-center">
            <p class="text-sm text-text-muted">No courses configured</p>
          </div>
        `;
        return;
      }

      let html = stats.courseStats.map(course => {
        const riskLevel = course.percentage < course.minAttendance ? "High" : course.percentage < 75 ? "Medium" : "Low";
        const riskColor = riskLevel === "High" ? "text-danger" : riskLevel === "Medium" ? "text-warning" : "text-success";
        
        return `
          <div class="p-4 rounded-lg bg-bg-tertiary/50 border border-border">
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full" style="background: ${course.color}"></div>
                <div>
                  <div class="text-sm font-semibold">${course.code}</div>
                  <div class="text-xs text-text-muted">${course.name}</div>
                </div>
              </div>
              <div class="text-right">
                <div class="text-lg font-bold ${course.percentage >= 75 ? 'text-success' : course.percentage >= 60 ? 'text-warning' : 'text-danger'}">${course.percentage}%</div>
                <div class="text-[10px] text-text-muted">Target: ${course.minAttendance}%</div>
              </div>
            </div>
            
            <div class="grid grid-cols-4 gap-4 text-center">
              <div>
                <div class="text-lg font-semibold text-text-primary">${course.attended}</div>
                <div class="text-[10px] text-text-muted">Attended</div>
              </div>
              <div>
                <div class="text-lg font-semibold text-text-primary">${course.absent}</div>
                <div class="text-[10px] text-text-muted">Absent</div>
              </div>
              <div>
                <div class="text-lg font-semibold text-text-primary">${course.late}</div>
                <div class="text-[10px] text-text-muted">Late</div>
              </div>
              <div>
                <div class="text-lg font-semibold ${riskColor}">${riskLevel}</div>
                <div class="text-[10px] text-text-muted">Risk Level</div>
              </div>
            </div>
          </div>
        `;
      }).join('');
      
      document.getElementById("course-deep-dive")!.innerHTML = html;
    }

    // Predictions
    function renderPredictions() {
      const courses = getCourses();
      
      if (courses.length === 0) {
        document.getElementById("predictions")!.innerHTML = `
          <div class="col-span-full py-8 text-center">
            <p class="text-sm text-text-muted">No courses configured</p>
          </div>
        `;
        return;
      }

      let html = courses.map(course => {
        const current = getCourseStats(course.id);
        const predicted = getPredictedPercentage(course.id, 30);
        const diff = predicted - current.percentage;
        const trend = diff > 0 ? "↑" : diff < 0 ? "↓" : "→";
        const trendColor = diff > 0 ? "text-success" : diff < 0 ? "text-danger" : "text-text-muted";
        
        return `
          <div class="p-4 rounded-lg bg-bg-tertiary/50 border border-border">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-2 h-2 rounded-full" style="background: ${course.color}"></div>
              <span class="text-xs font-medium">${course.code}</span>
            </div>
            <div class="space-y-1">
              <div class="flex justify-between text-xs">
                <span class="text-text-muted">Current</span>
                <span class="font-semibold">${current.percentage}%</span>
              </div>
              <div class="flex justify-between text-xs">
                <span class="text-text-muted">30-Day Prediction</span>
                <span class="font-semibold">${predicted}%</span>
              </div>
              <div class="flex justify-between text-xs">
                <span class="text-text-muted">Trend</span>
                <span class="font-semibold ${trendColor}">${trend} ${Math.abs(diff)}%</span>
              </div>
            </div>
          </div>
        `;
      }).join('');
      
      document.getElementById("predictions")!.innerHTML = html;
    }

    // Weekly Pattern
    function renderWeeklyPattern() {
      const records = getRecords();
      const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
      const dayStats = days.map(() => ({ attended: 0, total: 0 }));
      
      Object.entries(records).forEach(([dateStr, dayRecords]) => {
        const dayIndex = new Date(dateStr).getDay();
        Object.values(dayRecords).forEach((entry: any) => {
          if (["present", "late", "on_duty"].includes(entry.status)) {
            dayStats[dayIndex].attended++;
            dayStats[dayIndex].total++;
          } else if (entry.status === "absent") {
            dayStats[dayIndex].total++;
          }
        });
      });
      
      const percentages = dayStats.map(stat => 
        stat.total > 0 ? Math.round((stat.attended / stat.total) * 100) : 0
      );
      
      const maxVal = Math.max(...percentages, 1);
      
      let html = `<div class="flex items-end justify-between gap-2 h-full">`;
      
      percentages.forEach((pct, i) => {
        const height = (pct / maxVal) * 100;
        const color = pct >= 75 ? "bg-success" : pct >= 60 ? "bg-warning" : "bg-danger";
        
        html += `
          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="text-xs font-semibold ${pct >= 75 ? 'text-success' : pct >= 60 ? 'text-warning' : 'text-danger'}">${pct}%</div>
            <div class="w-full bg-bg-tertiary rounded-t overflow-hidden flex-1">
              <div class="w-full ${color} rounded-t transition-all duration-500" style="height: ${height}%"></div>
            </div>
            <div class="text-[10px] text-text-muted">${days[i].slice(0, 3)}</div>
          </div>
        `;
      });
      
      html += `</div>`;
      document.getElementById("weekly-pattern")!.innerHTML = html;
    }

    // Event Listeners
    function setupEventListeners() {
      document.querySelectorAll(".time-period-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const period = btn.dataset.period || "week";
          currentTimePeriod = period;
          
          document.querySelectorAll(".time-period-btn").forEach(b => {
            b.classList.remove("bg-accent", "text-white");
            b.classList.add("bg-bg-tertiary", "text-text-secondary");
          });
          btn.classList.remove("bg-bg-tertiary", "text-text-secondary");
          btn.classList.add("bg-accent", "text-white");
          
          // Re-render with new period (simplified for now)
          renderHeatMap();
        });
      });
    }

    // Start
    init();
  </script>
</Layout>
