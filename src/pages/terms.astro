---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="MyAttend" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- SEO Meta Tags -->
    <title>Terms & Conditions — MyAttendTracker Attendance Tracker</title>
    <meta name="description" content="MyAttendTracker Terms & Conditions. Free attendance tracker for students. By using MyAttendTracker, you agree to our terms. Read our complete terms of service here." />
    <meta name="keywords" content="terms and conditions, terms of service, user agreement, attendance tracker terms, app terms" />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Terms & Conditions — MyAttendTracker" />
    <meta property="og:description" content="Terms and conditions for using MyAttendTracker free attendance tracker app." />
    
    <!-- Canonical -->
    <link rel="canonical" href="https://myattendtracker.com/terms" />
    
    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="https://myattendtracker.com/sitemap.xml" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NEW43M9VQ1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-NEW43M9VQ1');
    </script>
  </head>
  <body class="min-h-screen bg-bg-primary text-text-primary font-sans">
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-bg-secondary/80 backdrop-blur-xl border-b border-border">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-md bg-accent flex items-center justify-center">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11l3 3 8-8"></path>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          </div>
          <span class="text-lg font-semibold tracking-tight">MyAttendTracker</span>
        </a>
        <div class="flex items-center gap-4">
          <a href="/about" class="text-sm text-text-secondary hover:text-text-primary transition-colors">About</a>
          <a href="/privacy" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Privacy</a>
          <a href="/contact" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Contact</a>
        </div>
      </div>
    </nav>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-24">
      <h1 class="text-3xl sm:text-4xl font-bold mb-8">Terms & Conditions</h1>
      <p class="text-sm text-text-muted mb-8">Last updated: January 2026</p>
      
      <div class="prose prose-invert prose-lg max-w-none space-y-6">
        <h2 class="text-xl font-semibold">1. Acceptance of Terms</h2>
        <p class="text-text-secondary">By accessing and using MyAttendTracker, you accept and agree to be bound by these Terms & Conditions. If you do not agree to these terms, please do not use the application.</p>
        
        <h2 class="text-xl font-semibold">2. Description of Service</h2>
        <p class="text-text-secondary">MyAttendTracker is a free attendance tracking application designed for students. The service allows users to:</p>
        <ul class="text-text-secondary list-disc pl-6 space-y-2">
          <li>Add and manage course information</li>
          <li>Set up weekly timetables</li>
          <li>Mark attendance for classes</li>
          <li>Track attendance statistics and analytics</li>
          <li>Calculate safe bunk counts</li>
          <li>Visualize attendance patterns</li>
        </ul>
        
        <h2 class="text-xl font-semibold">3. User Responsibilities</h2>
        <p class="text-text-secondary">As a user of MyAttendTracker, you agree to:</p>
        <ul class="text-text-secondary list-disc pl-6 space-y-2">
          <li>Provide accurate information when setting up courses and timetables</li>
          <li>Use the application for personal, non-commercial purposes</li>
          <li>Not attempt to reverse-engineer, decompile, or exploit the application</li>
          <li>Not use the application for any illegal or unauthorized purpose</li>
          <li>Respect the intellectual property rights of MyAttendTracker</li>
        </ul>
        
        <h2 class="text-xl font-semibold">4. Data Storage and Privacy</h2>
        <p class="text-text-secondary">MyAttendTracker stores all data locally on your device using browser localStorage. You are responsible for:</p>
        <ul class="text-text-secondary list-disc pl-6 space-y-2">
          <li>Maintaining the security of your device</li>
          <li>Backing up your data if needed</li>
          <li>Understanding that clearing browser data will delete your attendance records</li>
        </ul>
        <p class="text-text-secondary">MyAttendTracker is not responsible for any data loss that occurs due to device failure, browser data clearing, or other circumstances beyond our control.</p>
        
        <h2 class="text-xl font-semibold">5. Disclaimer of Warranties</h2>
        <p class="text-text-secondary">MyAttendTracker is provided "as is" without any warranties, express or implied. We do not guarantee that the application will be:</p>
        <ul class="text-text-secondary list-disc pl-6 space-y-2">
          <li>Uninterrupted or error-free</li>
          <li>Secure from all security threats</li>
          <li>Compatible with all devices or browsers</li>
          <li>Accurate in all calculations (though we strive for accuracy)</li>
        </ul>
        
        <h2 class="text-xl font-semibold">6. Limitation of Liability</h2>
        <p class="text-text-secondary">In no event shall MyAttendTracker be liable for any indirect, incidental, special, consequential, or punitive damages arising out of your use of the application. This includes but is not limited to loss of data, device damage, or academic consequences.</p>
        
        <h2 class="text-xl font-semibold">7. Academic Use</h2>
        <p class="text-text-secondary">MyAttendTracker is a tool to help you track attendance, but it is not a substitute for official attendance records maintained by your educational institution. Always verify your attendance with official records from your school or university. MyAttendTracker is not responsible for any academic consequences resulting from reliance on our attendance calculations.</p>
        
        <h2 class="text-xl font-semibold">8. Modifications to Service</h2>
        <p class="text-text-secondary">We reserve the right to modify, suspend, or discontinue the service at any time without prior notice. We are not liable to you or any third party for any modification, suspension, or discontinuation of the service.</p>
        
        <h2 class="text-xl font-semibold">9. Intellectual Property</h2>
        <p class="text-text-secondary">All content, features, and functionality of MyAttendTracker are owned by MyAttendTracker and are protected by copyright and other intellectual property laws. You may not copy, modify, distribute, or create derivative works without our express written permission.</p>
        
        <h2 class="text-xl font-semibold">10. Governing Law</h2>
        <p class="text-text-secondary">These terms shall be governed by and construed in accordance with the laws of the jurisdiction in which MyAttendTracker operates. Any disputes arising under these terms shall be subject to the exclusive jurisdiction of the courts in that jurisdiction.</p>
        
        <h2 class="text-xl font-semibold">11. Changes to Terms</h2>
        <p class="text-text-secondary">We reserve the right to modify these terms at any time. Continued use of the application after changes constitutes acceptance of the new terms. We will notify users of significant changes by updating the "Last updated" date on this page.</p>
        
        <h2 class="text-xl font-semibold">12. Contact Information</h2>
        <p class="text-text-secondary">If you have questions about these Terms & Conditions, please contact us through our Contact page. We will respond to your inquiries within a reasonable timeframe.</p>
      </div>
    </div>

    <!-- Footer -->
    <footer class="py-8 px-4 sm:px-6 border-t border-border">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-md bg-accent flex items-center justify-center">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11l3 3 8-8"></path>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          </div>
          <span class="text-sm font-medium">MyAttendTracker</span>
        </a>
        <p class="text-xs text-text-muted">© 2026 MyAttendTracker. Free attendance tracker for students.</p>
      </div>
    </footer>

    <style>
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      .prose h2 {
        color: var(--color-text-primary);
        font-weight: 600;
        margin-top: 2rem;
      }
      .prose p, .prose ul, .prose li {
        color: var(--color-text-secondary);
        line-height: 1.7;
      }
    </style>
  </body>
</html>
