              <li><a href="/bunk" class="text-xs text-text-muted hover:text-text-primary transition-colors">Bunk Calculator</a></li>
            </ul>
          </div>
          
          <div>
            <h4 class="text-sm font-semibold mb-4">Company</h4>
            <ul class="space-y-2">
              <li><a href="/about" class="text-xs text-text-muted hover:text-text-primary transition-colors">About Us</a></li>
              <li><a href="/contact" class="text-xs text-text-muted hover:text-text-primary transition-colors">Contact</a></li>
            <li><a href="/faq" class="text-xs text-text-muted hover:text-text-primary transition-colors">FAQ</a></li>
            <li><a href="/blog" class="text-xs text-text-muted hover:text-text-primary transition-colors">Blog</a></li>
            </ul>
          </div>
          
          <div>
            <h4 class="text-sm font-semibold mb-4">Legal</h4>
            <ul class="space-y-2">
              <li><a href="/privacy" class="text-xs text-text-muted hover:text-text-primary transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="text-xs text-text-muted hover:text-text-primary transition-colors">Terms & Conditions</a></li>
              <li><a href="/cookie-policy" class="text-xs text-text-muted hover:text-text-primary transition-colors">Cookie Policy</a></li>
            </ul>
          </div>
          
          <div>
